{
  // ─────────────────────────────────────────────────────────────────────────────
  // bds1.hjson — node 1 of a 3-node test cluster.
  //
  // Pair with bds2.hjson and bds3.hjson.  Node 1 acts as the bootstrap;
  // the other two pull its address from `cluster.bootstrap`.
  //
  // Run:   BDS_CONFIG=bds1.hjson cargo run --bin bdsnode -- --new --port 9711 -d 1
  // ─────────────────────────────────────────────────────────────────────────────

  // ── Storage (per-node — must be unique across the trio) ──
  dbpath:               "/tmp/bds-cluster/db1"
  shard_duration:       "1h"
  pool_size:            2
  max_open_shards:      8
  ingest_channel_capacity: 10000

  // Number of flusher threads draining the `ingest` channel.
  // The flush operation itself is internally serialised by
  // ShardsManager::add_batch — DuckDB/Tantivy/HNSW aren't
  // safe under concurrent same-shard writers — so raising this
  // doesn't speed up flushing.  Extra threads only help on bursty
  // workloads where batch accumulation is the bottleneck.
  // Default 1.  Clamped to [1, 16].
  pipe_flushers:    1

  // ── Background tasks ──
  drain_enabled:        true
  scheduler_interval_secs: 60   // fire stored BUND scripts whose crontab matches the current minute
  sync_interval_secs:      60    // periodic global sync still disabled for the test cluster
  n_workers:            2

  // ── Cluster ──
  cluster: {
    enabled:                 true
    shared_secret:           "test-cluster-secret-32-or-more-chars"

    // Where peers reach this node — must match --port below.
    bind_url:                "http://127.0.0.1:9711"

    // Node 1 has no `bootstrap` — it IS the bootstrap target for nodes 2 and 3.

    // Faster cadence for test feedback.
    gossip_interval:         "2s"
    suspect_timeout:         "10s"
    dead_timeout:            "30s"
    hint_replay_interval:    "5s"
    antientropy_interval:    "60s"
    peer_rpc_timeout:        "2s"

    // Scheduler dedup: suppress this node's fire when any peer (or
    // this node) executed the same script within the window.  Library
    // default is 5 min; tighter for the test cluster so cron patterns
    // like `* * * * *` can fire once per minute on a different node.
    scheduler_dedup_window:  "60s"

    // Full mode at 3 alive peers — exercises the full→partial transition
    // when one node goes down.
    full_mode_threshold:     3
    replication_factor:      3

    // Fully-replicated stores swept by anti-entropy.  Matches the
    // library default — users (Phase 7) + llm_cache (Phase 3.c) need
    // to be listed explicitly here because this config overrides the
    // default list entirely.
    full_replication_stores: ["docs", "signals", "scripts", "users", "llm_cache"]

    // Floating bootstrap: when n2/n3 restart and find n1 down, they'll
    // try every URL in their persisted peers.json in parallel — any
    // peer that responds becomes the effective bootstrap.  Set to
    // `false` for strict mode (only the configured `bootstrap` URL is
    // ever tried).
    floating_bootstrap:      true
    bootstrap_retry_interval: "30s"
  }

  // ── LLM (v4/llm.* surface) ──
  // Localhost Ollama only.  Each node calls its own 127.0.0.1:11434
  // instance, so `bdscmd llm ...` works against any node without
  // needing an external API key.
  llm: {
    default: "deepseek"
    providers: {
      ollama: {
        url:           "http://127.0.0.1:11434"
        default_model: "llama3.2"
      }

      // DeepSeek — chat-only (no embeddings).  Key resolution order:
      // $DEEPSEEK_API_KEY (preferred) → `api_key` field below.
      // Uncomment the `api_key` line if you want the cluster to use a
      // DeepSeek key without setting an env var; the env var still
      // wins when both are present.
      deepseek: {
        base_url:      "https://api.deepseek.com"
        api_key_env:   "DEEPSEEK_API_KEY"
        // api_key:    "sk-…"
        default_model: "deepseek-chat"
      }
    }

    // ── In-chat Bund snippet execution ──
    // When a chat message contains a ```bund fenced block (or starts
    // with a leading `/`), bdsnode evaluates the snippet locally and
    // splices the result into the LLM prompt instead of running the
    // standard aggregated-search RAG.  Off by default in the library
    // (any chat user can execute arbitrary Bund), on here because
    // this is a test cluster.
    chat: {
      bund: {
        enabled: true
      }
    }

    // ── English → Bund translator (v2/to.bund) ──
    // Lets callers ask the default LLM to draft a Bund script from
    // a natural-language request.  The RPC parses the result with
    // `bund_language_parser::bund_parse` and retries up to
    // `max_retries` times on parse failure.  It does NOT execute
    // the generated script — consumers (chat, bdscmd, bdsweb)
    // decide whether to run it.
    //
    //   enabled              — master switch (default true)
    //   timeout_secs         — provider HTTP timeout (10–600, default 120)
    //   max_retries          — corrective turns after first failure (0–5, default 2)
    //   provider             — "" = use llm.default; "ollama"/"anthropic"/…
    //   model                — "" = use that provider's default_model
    //   extra_system_prompt  — appended to the baked system prompt
    //                          (site-specific style/policy guidance)
    to_bund: {
      enabled:      true
      timeout_secs: 120
      max_retries:  2
    }
  }

  // ── Dev/demo: synthetic-data generator (generate_realistic_data) ──
  //
  // Off by default.  Enable via this block OR the
  // `--generate_realistic_data` bdsnode CLI flag (CLI wins regardless
  // of hjson).  When armed, bdsnode prints a loud WARN banner and
  // pushes one batch of fake telemetry through the local ingest
  // pipe every `interval_secs`.  v2/status.dev_data.enabled flips
  // to true; the bdsweb dashboard renders a red "SYNTHETIC DATA"
  // banner.  Production deployments MUST keep this off.
  //
  // See Documentation/DEV_DATA.md for the full operator guide.
  //
generate_realistic_data: {
     enabled:        true
     interval_secs:  3600         // clamped [5, 86400]
     duration:       "2h"       // humantime window each batch covers
     total:          2000       // target records per batch
     scenarios:      5          // incident cascades per batch
     noise_ratio:    0.7        // 0.0–0.95, background fraction
     anomaly_ratio:  0.02       // 0.0–0.10, rare-record fraction
     seed:           null       // null = entropy, integer = deterministic
}
retention: {
  enabled:                     true       // required to activate; default false
  duration:                    "1day"   // humantime; e.g. "7days", "6h"
  interval_secs:               300        // how often the background sweep runs
  max_evictions_per_run:       50         // per‑sweep cap; 0 = no cap
  dry_run:                     false      // log what would be evicted but don't delete
  reload_drain_after_evict:    true       // re‑run drain mining after eviction
  quorum_check_enabled:        false      // opt‑in cluster safety net (Phase 3)
}
  // ── bdsweb "Analyze this!" buttons (under web.analyze.<target>) ──
  // Per-target sub-blocks; more targets (rca, signals, …) will slot
  // in here alongside logs and metrics.  All keys are optional;
  // defaults live in bdsweb code.
  // web: {
  //   analyze: {
  //     logs: {
  //       timeout_secs: 600
  //       max_rows:     50
  //       prompt_template: '''
  //         You are reviewing a slice of operational log records …
  //       '''
  //     }
  //     metrics: {
  //       timeout_secs: 600
  //       max_rows:     50
  //       prompt_template: '''
  //         You are reviewing a slice of numeric telemetry records …
  //       '''
  //     }
  //     templates: {
  //       timeout_secs: 600
  //       max_rows:     50
  //       prompt_template: '''
  //         You are reviewing a slice of drain3-mined log templates …
  //       '''
  //     }
  //     agg_search: {
  //       timeout_secs: 600
  //       max_rows:     50
  //       prompt_template: '''
  //         You are reviewing the output of an aggregated search …
  //       '''
  //     }
  //     templates_summary: {
  //       timeout_secs: 600
  //       max_rows:     50
  //       prompt_template: '''
  //         You are reviewing two complementary derived views …
  //       '''
  //     }
  //     primary_summary: {
  //       timeout_secs: 600
  //       max_rows:     50
  //       prompt_template: '''
  //         You are reviewing a TextRank-PageRank summary of recent …
  //       '''
  //     }
  //     primary_query_summary: {
  //       timeout_secs: 600
  //       max_rows:     50
  //       prompt_template: '''
  //         You are reviewing a TextRank-PageRank summary that distills …
  //       '''
  //     }
  //     primary_lsa_summary: {
  //       timeout_secs: 600
  //       max_rows:     50
  //       prompt_template: '''
  //         You are reviewing an LSA (Latent Semantic Analysis) summary …
  //       '''
  //     }
  //     primary_lsa_query_summary: {
  //       timeout_secs: 600
  //       max_rows:     50
  //       prompt_template: '''
  //         You are reviewing a query-driven LSA (Latent Semantic Analysis) summary …
  //       '''
  //     }
  //     anomaly_recent: {
  //       timeout_secs: 600
  //       max_rows:     50
  //       prompt_template: '''
  //         You are reviewing the output of a rarity-based anomaly detector …
  //       '''
  //     }
  //     denoise_recent: {
  //       timeout_secs: 600
  //       max_rows:     50
  //       prompt_template: '''
