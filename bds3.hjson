{
  // ─────────────────────────────────────────────────────────────────────────────
  // bds3.hjson — node 3 of the 3-node test cluster (pair with bds1, bds2).
  //
  // Run:   BDS_CONFIG=bds3.hjson cargo run --bin bdsnode -- --new --port 9713 -d 1
  // ─────────────────────────────────────────────────────────────────────────────

  dbpath:               "/tmp/bds-cluster/db3"
  shard_duration:       "1h"
  pool_size:            2
  max_open_shards:      8
  ingest_channel_capacity: 10000

  drain_enabled:        true
  scheduler_interval_secs: 60   // fire stored BUND scripts whose crontab matches the current minute
  sync_interval_secs:      60
  n_workers:            2

  cluster: {
    enabled:                 true
    shared_secret:           "test-cluster-secret-32-or-more-chars"
    bind_url:                "http://127.0.0.1:9713"
    bootstrap:               "http://127.0.0.1:9711"

    gossip_interval:         "2s"
    suspect_timeout:         "10s"
    dead_timeout:            "30s"
    hint_replay_interval:    "5s"
    antientropy_interval:    "60s"
    peer_rpc_timeout:        "2s"

    // Scheduler dedup window — see bds1.hjson for rationale.
    scheduler_dedup_window:  "60s"

    // Full mode at 2 alive peers — see bds1.hjson for the rationale
    // (a 3-node cluster tops out at 2 alive peers per node).
    full_mode_threshold:     2
    replication_factor:      3

    full_replication_stores: ["docs", "signals", "scripts", "users", "llm_cache", "graph"]

    // Floating bootstrap (see bds1.hjson for details).
    floating_bootstrap:      true
    bootstrap_retry_interval: "30s"
  }

  // ── LLM (v4/llm.* surface) — see bds1.hjson for the rationale.
  llm: {
    default: "deepseek"
    providers: {
      ollama: {
        url:           "http://127.0.0.1:11434"
        default_model: "llama3.2"
      }

      // DeepSeek — see bds1.hjson for the key-resolution rationale.
      deepseek: {
        base_url:      "https://api.deepseek.com"
        api_key_env:   "DEEPSEEK_API_KEY"
        // api_key:    "sk-…"
        default_model: "deepseek-chat"
      }
    }

    // ── In-chat Bund snippet execution ── (see bds1.hjson)
    chat: {
      bund: {
        enabled: true
      }
    }
  }
  generate_realistic_data: {
     enabled:        true
     interval_secs:  3600         // clamped [5, 86400]
     duration:       "2h"       // humantime window each batch covers
     total:          2000       // target records per batch
     scenarios:      5          // incident cascades per batch
     noise_ratio:    0.7        // 0.0–0.95, background fraction
     anomaly_ratio:  0.02       // 0.0–0.10, rare-record fraction
     seed:           null       // null = entropy, integer = deterministic
}
// ── Shard retention — see bds1.hjson for the annotated rationale ──
retention: {
  enabled:                     true
  duration:                    "1day"
  interval_secs:               300
  max_evictions_per_run:       50
  dry_run:                     false
  reload_drain_after_evict:    true
  quorum_check_enabled:        true       // cluster safety net — only evict an interval peers also hold
  quorum_min_peers:            1
}

// ── Data rebalancer — repairs under-replicated sharded telemetry ──
rebalancer: {
  enabled:                     true
  interval:                    "2m"
  batch_size:                  50
  max_per_run:                 500
  min_replication_factor:      null       // inherit cluster.replication_factor
  pause_if_ingest_lag_p95_ms:  1000
}

// ── Self-healing — shard quarantine + rebuild healer ──
self_healing: {
  enabled:                     true
  interval:                    "30s"
  consistency_interval:        "5m"
  recreate_failed_shards:      true       // Tier-3: safe in cluster mode — peers repopulate
  failed_shard_recreate_after: "10m"
}
}
